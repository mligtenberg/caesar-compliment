{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/backend",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/backend"],
      "options": {
        "cwd": "apps/backend",
        "command": "dotnet build CaesarCompliment.Backend.csproj -c Release -o ../../dist/apps/backend"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "command": "dotnet watch run --project CaesarCompliment.Backend.csproj"
      }
    }
  }
}
